# Backend — Environment Variables
# DO NOT COMMIT THIS FILE. Add to .gitignore.
# Copy this file to .env and fill in real values.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: https://hvac-bis.vercel.app,https://yourdomain.com
# Leave empty to DENY all cross-origin requests in production.
ALLOWED_ORIGINS=https://your-vercel-frontend.vercel.app

# ─── Supabase (SERVER-SIDE ONLY — never expose to frontend) ───────────────────
SUPABASE_URL=https://yrqrbrwfencpyttaoihs.supabase.co

# Anon key (safe for read operations, subject to RLS)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (REQUIRED for server-side upserts that bypass RLS)
# Get this from: Supabase Dashboard → Settings → API → service_role key
# NEVER put this in the frontend or any public variable.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── AI / OCR (optional) ──────────────────────────────────────────────────────
# Required if AI-assisted extraction is enabled
GEMINI_API_KEY=your_gemini_api_key_here

# Required for scanned PDF OCR (optional — pipeline degrades gracefully)
OCR_API_KEY=your_ocr_api_key_here
