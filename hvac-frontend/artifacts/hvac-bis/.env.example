# ─── Frontend — Environment Variables (PUBLIC only — Vite inlines these at build time)
# All variables MUST start with VITE_ to be available in the browser bundle.
# DO NOT put backend secrets or service-role keys here.
# Copy this file to .env.local for local development.

# ─── Supabase (Frontend Auth — PUBLIC) ────────────────────────────────────────
# These are safe to expose to the browser. Supabase Row Level Security
# policies protect data access regardless of who has the anon key.
VITE_SUPABASE_URL=https://yrqrbrwfencpyttaoihs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# ─── Backend API URL (Production) ─────────────────────────────────────────────
# Set this to the Railway backend URL after deployment.
# Example: https://hvac-bis-production.up.railway.app
# If not set, the frontend falls back to http://localhost:3001 (dev only).
# THIS MUST BE SET IN VERCEL ENVIRONMENT VARIABLES FOR PRODUCTION.
VITE_BACKEND_API_URL=https://your-railway-backend.up.railway.app
